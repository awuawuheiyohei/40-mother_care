# =============================================================================
# Mother & Baby AI Assistant - Environment Variables
# Copy this file to `.env` and fill in real values.
# All vars with empty value will trigger MOCK mode for that component.
#
# Default config targets China-friendly providers:
#   LLM       -> DeepSeek-V3 (deepseek-chat)
#   Embedding -> BAAI/bge via SiliconFlow OR MiniMax embedding (pick one)
#   WeChat    -> Enterprise WeChat self-built app
# =============================================================================

# ---- App ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ---- Enterprise WeChat (企业微信自建应用) ----
# NOTE: WeChat callback mode is unreliable behind reverse tunnels
# (ngrok/cloudflared). We recommend DingTalk Stream mode instead — see
# DINGTALK_* below and docs/DINGTALK_SETUP.md.
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_CORP_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_CALLBACK_AES_KEY=
WECHAT_ALLOWED_USERS=

# ---- DingTalk (钉钉企业内部应用 + Stream 模式) ----
# Recommended over WeChat for personal use:
# - No callback URL verification (uses WebSocket, we connect OUT to DingTalk)
# - No ngrok/cloudflared needed
# - 5-minute setup
# Get these at https://open-dev.dingtalk.com → 企业内部应用 → 机器人能力
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# ---- LLM ----
# Recommended: DeepSeek-V3 (deepseek-chat) — strong Chinese, fast, cheap
# Alternative: MiniMax-Text-01 (https://api.MiniMax.chat/v1)
# Alternative: OpenAI gpt-4o-mini (https://api.openai.com/v1)
LLM_BASE_URL=https://api.deepseek.com
# Get your key at: https://platform.deepseek.com → API Keys
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=30

# ---- Embedding ----
# Option A (recommended): SiliconFlow — hosts BAAI/bge-large-zh-v1.5 (Chinese SOTA, 1024 dim)
#   Sign up at https://siliconflow.cn, get API key, use:
#     EMBED_BASE_URL=https://api.siliconflow.cn/v1
#     EMBED_MODEL=BAAI/bge-large-zh-v1.5
#     EMBED_DIM=1024
#
# Option B: MiniMax embedding (if your MiniMax plan includes embeddings)
#     EMBED_BASE_URL=https://api.MiniMax.chat/v1
#     EMBED_MODEL=<MiniMax 的 embedding 模型名>
#     EMBED_DIM=<对应维度>
#
# Option C: OpenAI text-embedding-3-small (requires stable OpenAI access)
#     EMBED_BASE_URL=https://api.openai.com/v1
#     EMBED_MODEL=text-embedding-3-small
#     EMBED_DIM=1536
EMBED_BASE_URL=https://api.siliconflow.cn/v1
# Get your key at: https://cloud.siliconflow.cn → API 密钥
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBED_DIM=1024

# ---- RAG ----
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_INDEX_PATH=./data/faiss.index
RAG_KB_PATH=./app/kb/data

# ---- Source Priority (higher = more authoritative) ----
# JSON map: {"WHO": 1.0, "Hospital": 1.0, "Curated": 0.7, "Internet": 0.4}
SOURCE_WEIGHTS={"WHO": 1.0, "CDC": 1.0, "Chinese Pediatric Guideline": 0.95, "Hospital": 0.85, "Curated": 0.7, "Internet": 0.4}